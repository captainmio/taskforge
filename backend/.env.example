NODE_ENV="development"
# Minimum JSON log level outside tests: fatal, error, warn, info, debug, or trace.
LOG_LEVEL="info"
# Save the same JSON records shown in stdout to bounded, rotated files.
LOG_FILE_ENABLED="true"
LOG_FILE_PATH="logs/application.log"
LOG_FILE_MAX_SIZE="10m"
# pino-roll keeps this many rotated files in addition to the active file.
LOG_FILE_RETENTION_COUNT="30"
PORT="3000"
FRONTEND_API="http://localhost:5173"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
BCRYPT_SALT_ROUNDS="12"
JWT_SECRET="replace-with-a-long-random-secret"

# REDIS_PORT controls the host port exposed by docker-compose.yml.
REDIS_PORT="6379"
# REDIS_URL is used by the backend API and invitation worker.
REDIS_URL="redis://127.0.0.1:6379"
# CACHE_REDIS_URL uses a separate logical database for application cache keys.
CACHE_REDIS_URL="redis://127.0.0.1:6379/1"
REDIS_CACHE_TTL_SECONDS="300"
INVITATION_LOG_PATH="logs/invitations.log"

# Application
# Runtime mode for the API and workers.
NODE_ENV="<development|test|production>"
# HTTP port used by the API server.
PORT="<api-port>"
# Browser origin allowed by API CORS.
FRONTEND_API="<frontend-url>"
# Public API base URL used in clickable email links.
BACKEND_PUBLIC_URL="<backend-public-url>"
# Optional artificial response delay in milliseconds; use 0 to disable it.
API_RESPONSE_DELAY_MS="<milliseconds>"

# Security
# PostgreSQL connection string used by the API and workers.
DATABASE_URL="<postgresql-connection-string>"
# bcrypt password-hashing cost factor.
BCRYPT_SALT_ROUNDS="<bcrypt-rounds>"
# Secret used to sign login JWTs. Never commit a real value.
JWT_SECRET="<long-random-secret>"
# JWT and login-cookie lifetime, for example 15m, 1h, or 1d.
JWT_EXPIRES_IN="<duration>"

# Application logging
# Minimum JSON log level: fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL="<log-level>"
# Whether rotated application logs are written in addition to stdout logs.
LOG_FILE_ENABLED="<true|false>"
# Relative or absolute path for the rotated application log file.
LOG_FILE_PATH="<application-log-path>"
# Maximum application-log file size before rotation, such as 10m.
LOG_FILE_MAX_SIZE="<size>"
# Number of rotated application-log files to retain.
LOG_FILE_RETENTION_COUNT="<count>"

# Redis: queues and cache
# Port exposed by the local Redis Docker service.
REDIS_PORT="<redis-port>"
# Redis connection used by BullMQ queues and workers.
REDIS_URL="<queue-redis-url>"
# Separate Redis logical database used for application cache entries.
CACHE_REDIS_URL="<cache-redis-url>"
# Number of seconds cached application data remains valid.
REDIS_CACHE_TTL_SECONDS="<seconds>"

# Transactional email (Mailtrap Demo Inbox)
# Mailtrap Sandbox SMTP hostname from Email Testing > Sandboxes > Integration.
SMTP_HOST="sandbox.smtp.mailtrap.io"
# Mailtrap Sandbox SMTP port; 2525 supports STARTTLS and is the recommended default.
SMTP_PORT="2525"
# Mailtrap Sandbox SMTP username; keep this secret.
SMTP_USERNAME="<mailtrap-sandbox-username>"
# Mailtrap Sandbox SMTP password; keep this secret.
SMTP_PASSWORD="<mailtrap-sandbox-password>"
# Optional Mailtrap API token, reserved for future API-based Mailtrap features.
SMTP_TOKEN="<mailtrap-api-token>"
# Sender identity displayed in captured Mailtrap messages.
EMAIL_FROM_ADDRESS="<display-name-and-verified-email>"
# Private JSON-lines log shared by registration and invitation email workers.
EMAIL_DELIVERY_LOG_PATH="<email-delivery-log-path>"

# Account email verification
# Number of hours a one-time registration-verification link remains valid.
ACCOUNT_VERIFICATION_TOKEN_TTL_HOURS="<hours>"
# Minimum seconds before the same unverified account can request another link.
ACCOUNT_VERIFICATION_RESEND_COOLDOWN_SECONDS="<seconds>"

# Password reset
# Number of minutes a one-time password-reset link remains valid.
PASSWORD_RESET_TOKEN_TTL_MINUTES="<minutes>"
# Minimum seconds before the same verified account can request another reset link.
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS="<seconds>"

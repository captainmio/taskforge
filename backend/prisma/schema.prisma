generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  firstname String @db.VarChar(100)
  lastname  String @db.VarChar(100)
  password  String @db.VarChar(255)
}

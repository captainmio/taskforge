generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  firstname            String                @db.VarChar(100)
  lastname             String                @db.VarChar(100)
  password             String                @db.VarChar(255)
  ownedWorkspaces      Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  sentInvitations      WorkspaceInvitation[] @relation("InvitationSender")
  createdInviteLinks   WorkspaceInviteLink[]  @relation("InviteLinkCreator")
  createdProjects      Project[]              @relation("ProjectCreator")
  createdTasks         Task[]                 @relation("TaskCreator")
  taskAssignments      TaskAssignee[]
  taskHistoryEvents    TaskHistory[]          @relation("TaskHistoryActor")
}

model Workspace {
  id          Int                   @id @default(autoincrement())
  name        String                @unique @db.VarChar(100)
  displayName String                @map("display_name") @db.VarChar(100)
  description String                @db.VarChar(500)
  icon        WorkspaceIcon
  ownerId     Int                   @map("owner_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  inviteLink  WorkspaceInviteLink?
  projects    Project[]

  @@index([ownerId])
}

model Project {
  id          Int                @id @default(autoincrement())
  workspaceId Int                @map("workspace_id")
  createdById Int                @map("created_by_id")
  name        String             @db.VarChar(100)
  description String             @db.VarChar(500)
  icon        ProjectIcon
  status      ProjectStatus      @default(planning)
  startDate   DateTime?          @map("start_date") @db.Date
  dueDate     DateTime?          @map("due_date") @db.Date
  defaultView ProjectDefaultView @default(list) @map("default_view")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]

  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
  @@index([createdById])
}

model Task {
  id           Int          @id @default(autoincrement())
  projectId    Int          @map("project_id")
  createdById  Int          @map("created_by_id")
  title        String       @db.VarChar(200)
  description  String       @default("") @db.Text
  status       TaskStatus   @default(todo)
  position     Int          @default(0)
  priority     TaskPriority @default(medium)
  dueDate      String?      @map("due_date") @db.VarChar(50)
  timeEstimate String?      @map("time_estimate") @db.VarChar(50)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees    TaskAssignee[]
  history      TaskHistory[]

  @@index([projectId])
  @@index([projectId, status, position])
  @@index([createdById])
}

model TaskHistory {
  id          Int      @id @default(autoincrement())
  taskId      Int      @map("task_id")
  actorUserId Int      @map("actor_user_id")
  action      String   @db.VarChar(50)
  changes     Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor       User     @relation("TaskHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorUserId])
}

model TaskAssignee {
  taskId Int  @map("task_id")
  userId Int  @map("user_id")
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model WorkspaceInviteLink {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @unique @map("workspace_id")
  createdById Int       @map("created_by_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
}

model WorkspaceMember {
  workspaceId Int           @map("workspace_id")
  userId      Int           @map("user_id")
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id                Int                      @id @default(autoincrement())
  workspaceId       Int                      @map("workspace_id")
  invitedById       Int                      @map("invited_by_id")
  email             String                   @db.VarChar(320)
  normalizedEmail   String                   @map("normalized_email") @db.VarChar(320)
  role              WorkspaceRole
  tokenHash         String                   @unique @map("token_hash") @db.VarChar(64)
  status            InvitationStatus         @default(PENDING)
  deliveryStatus    InvitationDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryAttempts  Int                      @default(0) @map("delivery_attempts")
  lastDeliveryError String?                  @map("last_delivery_error") @db.VarChar(500)
  queuedAt          DateTime?                @map("queued_at")
  deliveredAt       DateTime?                @map("delivered_at")
  expiresAt         DateTime                 @map("expires_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy         User                     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, normalizedEmail])
  @@index([invitedById])
  @@index([deliveryStatus, createdAt])
}

enum WorkspaceIcon {
  code
  business
  team
  launch
  goals
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectIcon {
  desktop
  mobile
  code
  launch
  flag
  database
  server
  design
  analytics
  marketing
  commerce
  quality
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
}

enum ProjectDefaultView {
  list
  board
  calendar
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum InvitationDeliveryStatus {
  PENDING
  QUEUED
  COMPLETED
  FAILED
}

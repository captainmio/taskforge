{
  "name": "typescripttuts",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,worker \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/invitation.worker.ts",
    "worker:invitations": "tsx src/workers/invitation.worker.ts",
    "worker:invitations:start": "node dist/workers/invitation.worker.js",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run test:typecheck && vitest run --config vitest.config.ts",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "test:watch": "vitest --config vitest.config.ts",
    "test:db:migrate": "prisma migrate deploy --config prisma.test.config.ts",
    "test:integration": "npm run test:db:migrate && vitest run --config vitest.database.config.ts",
    "test:all": "npm test && npm run test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
